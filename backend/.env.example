# Copy to .env and adjust. Every setting uses the APP_ prefix.
APP_ENV=dev
APP_LOG_LEVEL=INFO
# APP_DATABASE_URL=sqlite+aiosqlite:///./data/storefront.db
# APP_IMAGES_DIR=./data/images     # seeded product images, served at /images
# APP_ABO_DIR=./data/abo           # downloaded Amazon Berkeley Objects archives
# Signs session cookies and reset links; >= 32 bytes, required in prod:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_FRONTEND_URL=http://localhost:5173   # links in e-mails and OAuth redirects point here
# APP_SESSION_LIFETIME_SECONDS=604800     # login cookie / JWT lifetime (7 days)

# OAuth (optional; a provider is enabled only when both its id and secret are set).
# Register the redirect URI http://localhost:5173/auth/callback/<google|microsoft>.
APP_GOOGLE_CLIENT_ID=
APP_GOOGLE_CLIENT_SECRET=
APP_MICROSOFT_CLIENT_ID=
APP_MICROSOFT_CLIENT_SECRET=

# SMTP (optional; e.g. Mailpit on localhost:1025). Reset links are always logged.
# APP_SMTP_HOST=localhost
APP_SMTP_PORT=1025
# APP_EMAIL_FROM=Storefront <no-reply@storefront.local>

# Vector search. "hashing" + "numpy" are fast, model-free stand-ins used by tests.
APP_EMBEDDER=fastembed                    # fastembed | hashing
APP_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# APP_EMBEDDING_CACHE_DIR=./data/models   # downloaded ONNX model files
APP_VECTOR_STORE=chroma                   # chroma | numpy
# APP_VECTOR_STORE_PERSIST_DIR=./data/chroma   # unset = in-memory Chroma
